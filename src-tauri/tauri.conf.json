{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tolk",
  "version": "../package.json",
  "identifier": "com.stillmvd.tolk",
  "build": {
    "beforeDevCommand": "node scripts/mt.mjs && pnpm dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "node scripts/mt.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "template": "../node_modules/@stillmvd/tauri-ship/nsis/installer.nsi"
      }
    },
    "externalBin": [
      "binaries/tolk-mt"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyRUM4RTc2NUIxQTZDN0MKUldSOGJCcGJkbzdza3R1cTFub1d3a0NrZ0hFVWRxRkxjODZPWFdacWg2Zm5zUDZRc2xIelNMbXYK",
      "endpoints": [
        "https://github.com/stillmvd/tolk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
